DATABASE_URL="file:./dev.db"
AUTH_SECRET="" # Generieren mit: npx auth secret
AUTH_TRUST_HOST=true

# Apple ID OAuth (optional)
# AUTH_APPLE_ID=""
# AUTH_APPLE_SECRET=""

# Admin-Account (wird beim ersten db:seed erstellt)
ADMIN_EMAIL="admin@vermieterme.local"
ADMIN_PASSWORD="changeme123"

# OilFox/FoxInsights Customer API (server-side only)
OILFOX_USER=""
OILFOX_PW=""

# Google Cloud Vision: reuse the portal service account through runtime secrets.
GOOGLE_VISION_SERVICE_ACCOUNT_JSON_B64=""
# Alternative: mounted service-account JSON; never commit the actual file.
# GOOGLE_APPLICATION_CREDENTIALS="/run/secrets/google-vision.json"
GOOGLE_VISION_GCS_BUCKET=""
# Set only in the separate worker service sharing the app data volume.
INVOICE_WORKER_MODE=0

# Private ChatGPT MCP (public HTTPS base URL, no trailing slash)
MCP_BASE_URL="http://localhost:3000"
# Generate a distinct random secret with at least 32 characters.
MCP_SIGNING_SECRET=""

# Microsoft Graph app registration reused from MtBaCo. Runtime secrets only;
# supply to both web and worker. Sources/drive/folder IDs are selected in the
# database via confirmed domain previews, never inferred from a Windows path.
Application_client_ID=""
Directory_tenant_ID=""
CLIENT_SECRET_VALUE=""
# Optional shared original-document directory; both services use the same path.
# UPLOAD_DIR="/app/data/uploads"
