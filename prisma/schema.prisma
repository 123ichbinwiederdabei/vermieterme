generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Auth.js models
model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  accounts       Account[]
  sessions       Session[]
  mcpAuditEvents McpAuditEvent[]
}

// OAuth 2.1 records used by the private ChatGPT MCP connection. Secrets and
// authorization codes are stored only as hashes.
model McpOAuthClient {
  id                      String                 @id
  name                    String?
  redirectUrisJson        String
  tokenEndpointAuthMethod String                 @default("none")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  authorizationCodes      McpAuthorizationCode[]
  refreshTokens           McpRefreshToken[]
}

model McpAuthorizationCode {
  id                  String         @id @default(cuid())
  codeHash            String         @unique
  clientId            String
  userId              String
  redirectUri         String
  scopesJson          String
  resource            String
  codeChallenge       String
  codeChallengeMethod String         @default("S256")
  expiresAt           DateTime
  consumedAt          DateTime?
  client              McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt           DateTime       @default(now())

  @@index([clientId, expiresAt])
}

model McpRefreshToken {
  id         String         @id @default(cuid())
  tokenHash  String         @unique
  clientId   String
  userId     String
  scopesJson String
  resource   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  client     McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([clientId, userId])
  @@index([expiresAt])
}

model McpMutationTokenUse {
  id         String   @id
  userId     String
  entityType String
  itemRef    String
  usedAt     DateTime @default(now())

  @@index([userId, usedAt])
}

model McpAuditEvent {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  itemRef    String?
  reason     String
  requestId  String
  beforeJson String?
  afterJson  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, itemRef])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App models
model Property {
  id                   String                       @id @default(cuid())
  street               String
  zip                  String
  city                 String
  totalShares          Int                          @default(100)
  units                Unit[]
  billingPeriods       BillingPeriod[]
  externalBillings     ExternalBillingClosing[]
  heatingSystems       HeatingSystem[]
  electricityContracts ElectricityContract[]
  electricityMeters    ElectricityMeter[]
  costInvoices         CostInvoice[]
  storage              DocumentStorage?
  propertyTaxSetting   PropertyTaxSetting?
  costAllocationRules  PropertyCostAllocationRule[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
}

// The tax assessment can cover land or parts of a property that are not
// rented residential space.  This setting makes that separation explicit
// before any tenant allocation is calculated.
model PropertyTaxSetting {
  id                           String   @id @default(cuid())
  propertyId                   String   @unique
  annualAssessmentCents        BigInt?
  allocationMethod             String   @default("ALLOCATABLE_AMOUNT")
  annualAllocatableAmountCents BigInt?
  annualRateMicroCentsPerM2    BigInt?
  allocationNote               String?
  property                     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model Unit {
  id                      String                           @id @default(cuid())
  propertyId              String
  name                    String
  floor                   String
  shares                  Int
  areaM2                  Decimal?
  ownerOccupied           Boolean                          @default(false)
  property                Property                         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants                 Tenant[]
  prepayments             Prepayment[]
  rentChanges             RentChange[]
  heatingSystemLinks      HeatingSystemUnit[]
  electricityMeters       ElectricityMeter[]
  costAllocations         CostAllocation[]
  costAllocationRuleUnits PropertyCostAllocationRuleUnit[]
  statePeriods            UnitStatePeriod[]
  directInvoiceLines      CostInvoiceLine[]
  heatMeters              HeatMeter[]
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
}

model Tenant {
  id                     String                         @id @default(cuid())
  unitId                 String
  salutation             String
  firstName              String
  lastName               String
  salutation2            String?
  firstName2             String?
  lastName2              String?
  phone                  String?
  email                  String?
  bankName               String?
  iban                   String?
  accountHolder          String?
  moveInDate             DateTime
  moveOutDate            DateTime?
  leaseType              String                         @default("standard") // "standard", "index", "staffel"
  indexBaseYear          Int?
  indexReferenceValue    Float?
  indexReferenceDate     DateTime?
  indexMinMonths         Int                            @default(12)
  unit                   Unit                           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  documents              Document[]
  parties                LeaseParty[]
  accessToken            TenantAccessToken?
  financialPeriods       LeaseFinancialPeriod[]
  costAllocations        CostAllocation[]
  costCategoryAgreements LeaseCostCategoryAgreement[]
  externalBillings       ExternalBillingClosingTenant[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
}

model CostCategory {
  id                   String                       @id @default(cuid())
  name                 String
  distributionKey      String
  calculationType      String                       @default("MANUAL")
  code                 String                       @default("OTHER")
  invoiceTemplates     InvoiceTemplate[]
  sortOrder            Int                          @default(0)
  costs                Cost[]
  prepaymentComponents PrepaymentComponent[]
  costAllocations      CostAllocation[]
  invoices             CostInvoice[]
  leaseAgreements      LeaseCostCategoryAgreement[]
  allocationRules      PropertyCostAllocationRule[]
  flatRateCoverages    LeaseFlatRateCoverage[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
}

model BillingPeriod {
  id                 String                    @id @default(cuid())
  propertyId         String
  status             String                    @default("OPEN")
  startDate          DateTime
  endDate            DateTime
  billingDate        DateTime?
  sentDate           DateTime?
  paidDate           DateTime?
  sourceRevision     Int                       @default(0)
  revisionOfPeriodId String?
  revisionReason     String?
  copiedFromId       String?
  copiedFrom         BillingPeriod?            @relation("BillingCopy", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies             BillingPeriod[]           @relation("BillingCopy")
  property           Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  costs              Cost[]
  prepayments        Prepayment[]
  documents          Document[]
  calculationHeads   CategoryCalculationHead[]
  statementRevisions StatementRevision[]
  billingSnapshots   BillingSnapshot[]
  costAllocations    CostAllocation[]
  costInvoices       CostInvoice[]
  evidences          BillingPeriodEvidence[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model Cost {
  id                      String        @id @default(cuid())
  billingPeriodId         String
  costCategoryId          String
  totalAmount             Float
  totalAmountCents        BigInt?
  unitAmount              Float?
  reviewed                Boolean       @default(true)
  // Per-period overrides for the linked CostCategory. `enabled` hides this
  // category from this billing period without deleting it. `distributionKeyOverride`
  // replaces the category's default key for this period only (e.g. chimney
  // sweep that switches from "MEA" to "siehe Anlage" in a specific year).
  enabled                 Boolean       @default(true)
  distributionKeyOverride String?
  billingPeriod           BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  costCategory            CostCategory  @relation(fields: [costCategoryId], references: [id], onDelete: Cascade)
  createdAt               DateTime      @default(now())

  @@unique([billingPeriodId, costCategoryId])
}

model Prepayment {
  id              String        @id @default(cuid())
  billingPeriodId String
  unitId          String
  monthlyAmount   Float
  reviewed        Boolean       @default(true)
  billingPeriod   BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([billingPeriodId, unitId])
}

model RentChange {
  id            String   @id @default(cuid())
  unitId        String
  type          String // "rent" or "prepayment"
  amount        Float
  effectiveDate DateTime
  reason        String?
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([unitId, effectiveDate])
}

model PdfTemplate {
  id        String   @id @default(cuid())
  name      String   @default("Standard")
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VpiEntry {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  value     Float
  baseYear  Int      @default(2020)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, baseYear])
}

model Document {
  id                 String                 @id @default(cuid())
  billingPeriodId    String?
  tenantId           String?
  fileName           String
  originalName       String
  mimeType           String
  size               Int
  propertyId         String?
  archive            DocumentArchive?
  fileHash           String?
  invoiceAttachments InvoiceAttachment[]
  extractionJobs     InvoiceExtractionJob[]
  category           String                 @default("other") // "invoice", "receipt", "contract", "other"
  billingPeriod      BillingPeriod?         @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  tenant             Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  heatingOilDelivery HeatingOilDelivery?
  costInvoice        CostInvoice?           @relation("CostInvoiceDocument")
  createdAt          DateTime               @default(now())
}

// Beleggestuetzte manuelle Betriebskosten. Die Umlage wird ausschliesslich
// in der gemeinsamen serverseitigen Billing-Engine bestimmt.
model CostInvoice {
  id                 String                 @id @default(cuid())
  billingPeriodId    String?
  propertyId         String
  costCategoryId     String
  supplier           String?
  invoiceNumber      String?
  invoiceDate        DateTime?
  serviceDate        DateTime?
  // Inclusive service range. A one-off service stores the same value in both
  // fields; the legacy serviceDate remains the UI-compatible shortcut.
  servicePeriodStart DateTime?
  servicePeriodEnd   DateTime?
  totalAmountCents   BigInt
  status             String                 @default("DRAFT")
  section            String                 @default("OPERATING")
  dataJson           String                 @default("{}")
  confirmedBy        String?
  confirmedAt        DateTime?
  revisionOfId       String?
  revisionOf         CostInvoice?           @relation("InvoiceRevisions", fields: [revisionOfId], references: [id], onDelete: Restrict)
  revisions          CostInvoice[]          @relation("InvoiceRevisions")
  attachments        InvoiceAttachment[]
  extractionJobs     InvoiceExtractionJob[]
  note               String?
  documentId         String?                @unique
  billingPeriod      BillingPeriod?         @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)
  property           Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  costCategory       CostCategory           @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)
  document           Document?              @relation("CostInvoiceDocument", fields: [documentId], references: [id], onDelete: SetNull)
  lines              CostInvoiceLine[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([billingPeriodId, costCategoryId])
}

model CostInvoiceLine {
  id                      String      @id @default(cuid())
  costInvoiceId           String
  description             String
  amountCents             BigInt
  classification          String
  confirmedRunningExpense Boolean     @default(false)
  directUnitId            String?
  costInvoice             CostInvoice @relation(fields: [costInvoiceId], references: [id], onDelete: Cascade)
  directUnit              Unit?       @relation(fields: [directUnitId], references: [id], onDelete: SetNull)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([directUnitId])
}

// The landlord's documented check of a contractual operating-cost agreement.
// It documents the decision and does not replace legal advice.
model LeaseCostCategoryAgreement {
  id                 String       @id @default(cuid())
  tenantId           String
  costCategoryId     String
  validFrom          DateTime
  validTo            DateTime?
  confirmedAt        DateTime     @default(now())
  confirmedBy        String
  contractDocumentId String?
  note               String?
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costCategory       CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([tenantId, costCategoryId, validFrom])
}

model TenantAccessToken {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LandlordInfo {
  id            String   @id @default(cuid())
  name          String
  street        String
  zip           String
  city          String
  phone         String?
  email         String?
  bankName      String?
  iban          String?
  accountHolder String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Billing v2: heating oil, electricity, exact allocations and financial history.
// Money is stored as integer cents. Decimal quantities are serialized through
// APIs as strings and are never converted to JS Number for billing arithmetic.

model HeatingSystem {
  activeTankId            String?
  id                      String              @id @default(cuid())
  propertyId              String
  name                    String
  energySource            String              @default("HEATING_OIL")
  supplyType              String              @default("CENTRAL")
  billingRegime           String              @default("STANDARD_HEIZKOSTENV")
  consumptionSharePercent Int                 @default(50)
  baseSharePercent        Int                 @default(50)
  consumptionSource       String              @default("NONE")
  centralHotWater         Boolean             @default(false)
  evidenceValidatedAt     DateTime?
  evidenceValidatedBy     String?
  ownerOccupiedUnitId     String?
  contractualValidFrom    DateTime?
  contractualReason       String?
  contractualDocumentId   String?
  exceptionReasonCode     String?
  exceptionReason         String?
  exceptionValidFrom      DateTime?
  exceptionValidTo        DateTime?
  exceptionDocumentId     String?
  property                Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units                   HeatingSystemUnit[]
  tanks                   HeatingOilTank[]
  heatMeters              HeatMeter[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([propertyId])
}

model HeatingSystemUnit {
  heatingSystemId String
  unitId          String
  heatingSystem   HeatingSystem @relation(fields: [heatingSystemId], references: [id], onDelete: Cascade)
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([heatingSystemId, unitId])
}

model HeatingOilTank {
  id                               String                 @id @default(cuid())
  heatingSystemId                  String
  name                             String
  capacityLiters                   Decimal?
  deliveryDetectionThresholdLiters Decimal                @default(200)
  location                         String?
  manufacturer                     String?
  model                            String?
  serialNumber                     String?
  tankType                         String?
  material                         String?
  lengthMm                         Decimal?
  widthMm                          Decimal?
  heightMm                         Decimal?
  diameterMm                       Decimal?
  usableVolumeLiters               Decimal?
  measurementNotes                 String?
  notes                            String?
  activeFrom                       DateTime?
  activeTo                         DateTime?
  archivedAt                       DateTime?
  heatingSystem                    HeatingSystem          @relation(fields: [heatingSystemId], references: [id], onDelete: Cascade)
  deliveries                       HeatingOilDelivery[]
  inventoryLots                    OilInventoryLot[]
  stockReadings                    OilStockReading[]
  oilFoxDevices                    OilFoxDevice[]
  deliveryCandidates               OilDeliveryCandidate[]
  oilFoxCsvImports                 OilFoxCsvImport[]
  inventoryBaselines               OilInventoryBaseline[]
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt

  @@index([heatingSystemId])
}

model HeatingOilDelivery {
  revisionOfId           String?
  revisionOf             HeatingOilDelivery?   @relation("DeliveryRevisions", fields: [revisionOfId], references: [id], onDelete: Restrict)
  revisions              HeatingOilDelivery[]  @relation("DeliveryRevisions")
  id                     String                @id @default(cuid())
  tankId                 String
  deliveryDate           DateTime
  invoiceDate            DateTime?
  quantityLiters         Decimal
  totalAmountCents       BigInt
  additionalChargesCents BigInt                @default(0)
  priceCentsPerLiter     Int?
  co2CostCents           BigInt                @default(0)
  co2Grams               BigInt                @default(0)
  emissionFactorMicrogWh BigInt                @default(0)
  energyContentKwh       Decimal               @default(0)
  invoiceNumber          String?
  supplier               String?
  documentId             String?               @unique
  beforeMeasurementId    String?
  afterMeasurementId     String?
  detectedIncreaseLiters Decimal?
  confirmationStatus     String                @default("CONFIRMED")
  notes                  String?
  tank                   HeatingOilTank        @relation(fields: [tankId], references: [id], onDelete: Cascade)
  inventoryLot           OilInventoryLot?
  document               Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  deliveryCandidate      OilDeliveryCandidate?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([tankId, deliveryDate])
}

model OilInventoryLot {
  revisionOfId           String?
  revisionNumber         Int                   @default(1)
  revisionOf             OilInventoryLot?      @relation("LotRevisions", fields: [revisionOfId], references: [id], onDelete: Restrict)
  revisions              OilInventoryLot[]     @relation("LotRevisions")
  id                     String                @id @default(cuid())
  tankId                 String
  deliveryId             String?               @unique
  sourceType             String
  sourceDate             DateTime
  quantityLiters         Decimal
  totalAmountCents       BigInt
  co2CostCents           BigInt                @default(0)
  co2Grams               BigInt                @default(0)
  emissionFactorMicrogWh BigInt                @default(0)
  energyContentKwh       Decimal               @default(0)
  note                   String?
  tank                   HeatingOilTank        @relation(fields: [tankId], references: [id], onDelete: Cascade)
  delivery               HeatingOilDelivery?   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  co2EvidenceReference   String?
  consumptions           OilLotConsumption[]
  createdAt              DateTime              @default(now())
  OilInventoryBaseline   OilInventoryBaseline?

  @@index([tankId, sourceDate])
}

model OilLotConsumption {
  id             String          @id @default(cuid())
  lotId          String
  snapshotId     String
  quantityLiters Decimal
  amountCents    BigInt
  co2CostCents   BigInt
  co2Grams       BigInt
  active         Boolean         @default(true)
  lot            OilInventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  snapshot       BillingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())

  @@unique([lotId, snapshotId])
  @@index([snapshotId, active])
}

model OilStockReading {
  id                         String                 @id @default(cuid())
  tankId                     String
  oilFoxDeviceId             String?
  deviceHwid                 String?
  readingDate                DateTime
  billingEffectiveDate       DateTime?
  quantityLiters             Decimal?
  fillLevelPercent           Int?
  batteryLevel               String?
  validationError            String?
  distanceCm                 Decimal?
  meteringStatus             String?
  manuallyInvalidated        Boolean?
  meteringType               String?
  signalStrength             String?
  method                     String                 @default("MANUAL")
  source                     String                 @default("MANUAL")
  confirmed                  Boolean                @default(false)
  note                       String?
  documentId                 String?
  oilFoxCsvImportId          String?
  tank                       HeatingOilTank         @relation(fields: [tankId], references: [id], onDelete: Cascade)
  oilFoxDevice               OilFoxDevice?          @relation(fields: [oilFoxDeviceId], references: [id], onDelete: SetNull)
  oilFoxCsvImport            OilFoxCsvImport?       @relation(fields: [oilFoxCsvImportId], references: [id], onDelete: SetNull)
  previousDeliveryCandidates OilDeliveryCandidate[] @relation("BeforeMeasurement")
  nextDeliveryCandidates     OilDeliveryCandidate[] @relation("AfterMeasurement")
  createdAt                  DateTime               @default(now())

  @@unique([oilFoxDeviceId, readingDate])
  @@index([tankId, readingDate])
  @@index([oilFoxCsvImportId])
}

model OilFoxDevice {
  id                String            @id @default(cuid())
  hwid              String            @unique
  tankId            String?
  enabled           Boolean           @default(true)
  quantityUnit      String?
  connectionStatus  String            @default("DISCOVERED")
  lastMeasurementAt DateTime?
  nextMeasurementAt DateTime?
  lastSyncAt        DateTime?
  lastError         String?
  apiVersion        String?
  apiWarning        String?
  tank              HeatingOilTank?   @relation(fields: [tankId], references: [id], onDelete: SetNull)
  readings          OilStockReading[]
  csvImports        OilFoxCsvImport[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([tankId])
}

// Auditable, idempotent CSV upload reference. Readings remain uniquely
// identified by OilFox device and measurement timestamp.
model OilFoxCsvImport {
  id                String            @id @default(cuid())
  tankId            String
  deviceId          String
  fileName          String
  fileHash          String
  importedRows      Int               @default(0)
  skippedDuplicates Int               @default(0)
  invalidRows       Int               @default(0)
  warningsJson      String            @default("[]")
  importedAt        DateTime          @default(now())
  tank              HeatingOilTank    @relation(fields: [tankId], references: [id], onDelete: Cascade)
  device            OilFoxDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings          OilStockReading[]

  @@unique([tankId, deviceId, fileHash])
  @@index([tankId, importedAt])
}

model OilDeliveryCandidate {
  id                      String              @id @default(cuid())
  tankId                  String
  beforeMeasurementId     String
  afterMeasurementId      String              @unique
  estimatedIncreaseLiters Decimal
  confidence              String              @default("MEDIUM")
  status                  String              @default("PENDING")
  deliveryId              String?             @unique
  note                    String?
  reviewedAt              DateTime?
  tank                    HeatingOilTank      @relation(fields: [tankId], references: [id], onDelete: Cascade)
  beforeMeasurement       OilStockReading     @relation("BeforeMeasurement", fields: [beforeMeasurementId], references: [id], onDelete: Restrict)
  afterMeasurement        OilStockReading     @relation("AfterMeasurement", fields: [afterMeasurementId], references: [id], onDelete: Restrict)
  delivery                HeatingOilDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  createdAt               DateTime            @default(now())

  @@index([tankId, status])
}

model OilFoxSyncState {
  id            String    @id @default("global")
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  leaseUntil    DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ElectricityContract {
  id                     String              @id @default(cuid())
  propertyId             String
  provider               String
  contractReference      String?
  validFrom              DateTime
  validTo                DateTime?
  basePriceAgreementNote String?
  basePriceAllocation    String              @default("BY_CONSUMPTION")
  property               Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tariffs                ElectricityTariff[]
  meters                 ElectricityMeter[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([propertyId])
}

model ElectricityTariff {
  id                     String              @id @default(cuid())
  contractId             String
  validFrom              DateTime
  validTo                DateTime?
  billingValidFrom       DateTime?
  billingValidTo         DateTime?
  billingEffectiveReason String?
  // Unit prices need more precision than final Euro-cent amounts.  One Euro
  // equals 1,000,000 micro-euro; final allocation amounts remain cents.
  sourceDocumentId       String?
  vatRate                Decimal?
  priceMicroEuroPerKwh   BigInt
  monthlyBasePriceCents  BigInt
  name                   String?
  contract               ElectricityContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([contractId, validFrom])
}

model ElectricityMeter {
  id          String               @id @default(cuid())
  contractId  String
  propertyId  String
  unitId      String?
  meterNumber String
  role        String
  validFrom   DateTime
  validTo     DateTime?
  contract    ElectricityContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit        Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  readings    ElectricityReading[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([contractId, meterNumber])
  @@index([propertyId, unitId])
}

model ElectricityReading {
  id                   String                    @id @default(cuid())
  meterId              String
  readingDate          DateTime
  billingEffectiveDate DateTime?
  readingKwh           Decimal
  reason               String                    @default("REGULAR")
  estimationMethod     String?
  uncertaintyNote      String?
  confirmed            Boolean                   @default(true)
  note                 String?
  meter                ElectricityMeter          @relation(fields: [meterId], references: [id], onDelete: Cascade)
  createdAt            DateTime                  @default(now())
  audits               ElectricityReadingAudit[]

  @@unique([meterId, readingDate])
}

// An externally completed accounting period without invented costs or a
// fabricated start date. It is intentionally immutable after creation.
model ExternalBillingClosing {
  id          String                         @id @default(cuid())
  propertyId  String
  closingDate DateTime
  note        String?
  createdBy   String?
  property    Property                       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants     ExternalBillingClosingTenant[]
  createdAt   DateTime                       @default(now())

  @@unique([propertyId, closingDate])
  @@index([propertyId, closingDate])
}

model ExternalBillingClosingTenant {
  closingId String
  tenantId  String
  closing   ExternalBillingClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([closingId, tenantId])
  @@index([tenantId])
}

// Every correction of a cumulative meter reading is retained as an audit
// record. It is deliberately separate from the mutable current reading.
model ElectricityReadingAudit {
  id           String              @id @default(cuid())
  readingId    String?
  meterId      String
  action       String
  previousJson String
  reason       String
  createdAt    DateTime            @default(now())
  reading      ElectricityReading? @relation(fields: [readingId], references: [id], onDelete: SetNull)

  @@index([meterId, createdAt])
}

model LeaseFinancialPeriod {
  id                                               String                  @id @default(cuid())
  tenantId                                         String
  validFrom                                        DateTime
  validTo                                          DateTime?
  monthlyColdRentCents                             BigInt
  monthlyPrepaymentCents                           BigInt
  monthlyGeneralOperatingAndHeatingPrepaymentCents BigInt                  @default(0)
  sourceDocumentId                                 String?
  monthlyElectricityPrepaymentCents                BigInt                  @default(0)
  monthlyFlatRateCents                             BigInt                  @default(0)
  reason                                           String?
  revisionOfId                                     String?
  revisionReason                                   String?
  supersededAt                                     DateTime?
  createdBy                                        String?
  tenant                                           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  components                                       PrepaymentComponent[]
  flatRateCoverages                                LeaseFlatRateCoverage[]
  createdAt                                        DateTime                @default(now())

  @@index([tenantId, validFrom])
}

model PrepaymentComponent {
  id                 String               @id @default(cuid())
  financialPeriodId  String
  costCategoryId     String
  monthlyAmountCents BigInt
  financialPeriod    LeaseFinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)
  costCategory       CostCategory         @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  @@unique([financialPeriodId, costCategoryId])
}

model BillingSnapshot {
  id                String                   @id @default(cuid())
  billingPeriodId   String
  costCategoryId    String?
  kind              String
  status            String                   @default("APPLIED")
  sourceFingerprint String
  sourceJson        String
  resultJson        String
  revisionOfId      String?
  appliedBy         String?
  billingPeriod     BillingPeriod            @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  oilConsumptions   OilLotConsumption[]
  allocations       CostAllocation[]
  activeHead        CategoryCalculationHead?
  createdAt         DateTime                 @default(now())

  @@index([billingPeriodId, kind])
}

model CostAllocation {
  id                String                      @id @default(cuid())
  billingPeriodId   String
  costCategoryId    String
  unitId            String
  tenantId          String?
  periodStart       DateTime
  periodEnd         DateTime
  amountCents       BigInt
  quantity          Decimal?
  distributionKey   String
  calculationBasis  String
  sourceType        String
  sourceReferenceId String?
  snapshotId        String?
  allocationRuleId  String?
  billingPeriod     BillingPeriod               @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  costCategory      CostCategory                @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)
  unit              Unit                        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant            Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  snapshot          BillingSnapshot?            @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  allocationRule    PropertyCostAllocationRule? @relation(fields: [allocationRuleId], references: [id], onDelete: SetNull)
  createdAt         DateTime                    @default(now())

  @@index([billingPeriodId, costCategoryId])
  @@index([tenantId])
  @@index([allocationRuleId])
}

// Effective-dated allocation policy. Percentages are derived from the stored
// area or weight and are never persisted as the source of truth.
model PropertyCostAllocationRule {
  purpose                               String                           @default("TOTAL")
  supersededAt                          DateTime?
  revisionOfId                          String?
  consumptionSharePercent               Int?
  id                                    String                           @id @default(cuid())
  propertyId                            String
  costCategoryId                        String
  allocationMethod                      String
  validFrom                             DateTime
  validTo                               DateTime?
  requiresTenantAgreement               Boolean                          @default(false)
  explanation                           String?
  sourceDocumentId                      String?
  sourceNote                            String?
  residentialEquivalentMicroEuroPerM2   BigInt?
  residentialAssessmentFactorMillionths BigInt?
  municipalHebesatzBasisPoints          BigInt?
  annualAssessmentCents                 BigInt?
  createdBy                             String?
  property                              Property                         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  costCategory                          CostCategory                     @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)
  units                                 PropertyCostAllocationRuleUnit[]
  allocations                           CostAllocation[]
  createdAt                             DateTime                         @default(now())
  updatedAt                             DateTime                         @updatedAt

  @@index([propertyId, costCategoryId, validFrom])
}

model PropertyCostAllocationRuleUnit {
  ruleId   String
  unitId   String
  included Boolean                    @default(true)
  weight   Decimal?
  areaM2   Decimal?
  rule     PropertyCostAllocationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  unit     Unit                       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([ruleId, unitId])
  @@index([unitId])
}

model LeaseFlatRateCoverage {
  financialPeriodId String
  costCategoryId    String
  financialPeriod   LeaseFinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)
  costCategory      CostCategory         @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  @@id([financialPeriodId, costCategoryId])
}

model HeatMeter {
  id              String             @id @default(cuid())
  heatingSystemId String
  unitId          String
  meterNumber     String
  meterType       String             @default("HEAT")
  validFrom       DateTime
  validTo         DateTime?
  heatingSystem   HeatingSystem      @relation(fields: [heatingSystemId], references: [id], onDelete: Cascade)
  unit            Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  readings        HeatMeterReading[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([heatingSystemId, meterNumber])
  @@index([unitId])
}

model HeatMeterReading {
  id                   String    @id @default(cuid())
  meterId              String
  readingDate          DateTime
  billingEffectiveDate DateTime?
  readingValue         Decimal
  confirmed            Boolean   @default(false)
  sourceDocumentId     String?
  source               String    @default("MANUAL")
  notes                String?
  meter                HeatMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())

  @@unique([meterId, readingDate])
}

// A verified inventory cut-over for the first internally billed period. The
// linked inventory lot is the only pre-boundary lot admitted into FIFO.
model OilInventoryBaseline {
  id                  String          @id @default(cuid())
  tankId              String
  effectiveDate       DateTime
  sourceMeasurementId String?
  inventoryLotId      String          @unique
  confirmedBy         String?
  confirmedAt         DateTime?
  sourceDocumentId    String?
  note                String?
  tank                HeatingOilTank  @relation(fields: [tankId], references: [id], onDelete: Cascade)
  inventoryLot        OilInventoryLot @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  createdAt           DateTime        @default(now())

  @@unique([tankId, effectiveDate])
}

model BillingPeriodEvidence {
  id              String        @id @default(cuid())
  billingPeriodId String
  kind            String
  documentId      String?
  note            String?
  confirmedBy     String
  confirmedAt     DateTime      @default(now())
  billingPeriod   BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([billingPeriodId, kind])
}

// Published versions are immutable; edits create a new draft version.
model InvoiceTemplate {
  id              String                 @id @default(cuid())
  seriesId        String
  version         Int
  costCategoryId  String
  name            String
  supplier        String
  section         String                 @default("OPERATING")
  status          String                 @default("DRAFT")
  rulesJson       String
  markersJson     String
  testResultsJson String?
  testedHash      String?
  createdBy       String
  createdAt       DateTime               @default(now())
  publishedAt     DateTime?
  costCategory    CostCategory           @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)
  extractionJobs  InvoiceExtractionJob[]

  @@unique([seriesId, version])
  @@index([costCategoryId, status])
}

model InvoiceAttachment {
  invoiceId  String
  documentId String
  invoice    CostInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([invoiceId, documentId])
}

model InvoiceExtractionJob {
  id          String           @id @default(cuid())
  invoiceId   String
  documentId  String
  templateId  String?
  status      String           @default("QUEUED")
  attempts    Int              @default(0)
  leaseUntil  DateTime?
  availableAt DateTime         @default(now())
  ocrJson     String?
  resultJson  String?
  error       String?
  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invoice     CostInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  document    Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  template    InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
}

// The mutable pointer is separate from immutable snapshots and consumptions.
model CategoryCalculationHead {
  billingPeriodId String
  costCategoryId  String
  snapshotId      String          @unique
  stale           Boolean         @default(false)
  billingPeriod   BillingPeriod   @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  snapshot        BillingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@id([billingPeriodId, costCategoryId])
}

model StatementRevision {
  id                 String        @id @default(cuid())
  billingPeriodId    String
  tenantId           String
  revision           Int
  revisionOfId       String?
  reason             String?
  payloadJson        String
  snapshotIdsJson    String
  calculationVersion String        @default("krandorf-v3")
  issuedBy           String
  createdAt          DateTime      @default(now())
  billingPeriod      BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)

  @@unique([billingPeriodId, tenantId, revision])
}

// Effective-dated unit metadata: no historical state is inferred on migration.
model UnitStatePeriod {
  id               String    @id @default(cuid())
  unitId           String
  validFrom        DateTime
  validTo          DateTime?
  areaM2           Decimal
  ownerOccupied    Boolean
  sourceDocumentId String
  unit             Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@index([unitId, validFrom])
}

// Tenant remains the stable legacy tenancy identifier; additional parties do not
// create additional cost recipients or duplicate advance payments.
model LeaseParty {
  id               String    @id @default(cuid())
  tenantId         String
  firstName        String
  lastName         String
  email            String?
  validFrom        DateTime
  validTo          DateTime?
  sourceDocumentId String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model DomainChangePreview {
  id          String    @id @default(cuid())
  userId      String
  action      String
  payloadJson String
  fingerprint String
  impactJson  String
  expiresAt   DateTime
  consumedAt  DateTime?
  resultJson  String?
  createdAt   DateTime  @default(now())
}

model DocumentStorage {
  testedAt          DateTime?
  testedFingerprint String?
  id                String    @id @default(cuid())
  propertyId        String    @unique
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  driveId           String
  rootItemId        String
  objectFolder      String
  enabled           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([driveId, rootItemId, objectFolder])
}

model DocumentArchive {
  id           String   @id @default(cuid())
  documentId   String   @unique
  document     Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  storageId    String
  relativePath String
  sha256       String
  size         Int
  itemId       String?
  status       String   @default("PENDING")
  error        String?
  updatedAt    DateTime @updatedAt

  @@unique([storageId, relativePath])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  kind        String
  dedupeKey   String    @unique
  payloadJson String
  status      String    @default("QUEUED")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
}

model MicrosoftImportSource {
  testedAt          DateTime?
  testedFingerprint String?
  id                String    @id @default(cuid())
  propertyId        String
  kind              String
  mailbox           String?
  folderId          String
  driveId           String?
  costCategoryId    String
  section           String
  enabled           Boolean   @default(false)
  autoBook          Boolean   @default(false)
  intervalMinutes   Int       @default(15)
  cursor            String?
  nextRunAt         DateTime  @default(now())
  lastError         String?
  createdBy         String
}

model ImportedSourceItem {
  id            String  @id @default(cuid())
  sourceId      String
  sourceKey     String
  documentId    String
  invoiceId     String
  sourceVersion String?

  @@unique([sourceId, sourceKey])
}

model StatementArtifact {
  id              String   @id @default(cuid())
  billingPeriodId String
  tenantId        String
  revision        Int?
  previewId       String?
  status          String   @default("DRAFT")
  fingerprint     String
  statementJson   String
  documentId      String   @unique
  createdBy       String
  createdAt       DateTime @default(now())

  @@unique([billingPeriodId, tenantId, revision])
}

model StatementDispatch {
  id             String    @id @default(cuid())
  artifactId     String
  previewId      String    @unique
  mailbox        String
  recipient      String
  subject        String
  bodyText       String
  graphMessageId String?
  status         String    @default("PENDING")
  acceptedAt     DateTime?
  error          String?
  createdBy      String
  createdAt      DateTime  @default(now())
}

model BillingNotice {
  id         String    @id @default(cuid())
  propertyId String
  key        String
  message    String
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([propertyId, key])
}

model InvoiceConsumption {
  billingPeriodId String
  id              String   @id @default(cuid())
  invoiceId       String
  lineId          String
  snapshotId      String
  periodStart     DateTime
  periodEnd       DateTime
  amountCents     BigInt

  @@unique([lineId, snapshotId])
}

model AllocationConsumptionReading {
  id               String   @id @default(cuid())
  costCategoryId   String
  unitId           String
  readingDate      DateTime
  quantity         Decimal
  confirmed        Boolean  @default(false)
  sourceDocumentId String

  @@unique([costCategoryId, unitId, readingDate])
}

model InvoiceVerifiedSample {
  id                String   @id @default(cuid())
  documentId        String   @unique
  fileHash          String
  expectedJson      String
  expectedLinesJson String
  role              String
  confirmedBy       String
  confirmedAt       DateTime @default(now())
}
